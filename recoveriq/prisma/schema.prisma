generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  password    String
  role        String   @default("Officer") // Superadmin | Admin | Manager | Officer | Viewer
  region      String?
  countyScope String?  // comma-separated county codes

  // Multi-Factor Authentication (TOTP). `mfaSecret` is the base32 shared
  // secret; `mfaEnabled` flips true only after the user verifies a code
  // during enrollment.
  mfaSecret  String?
  mfaEnabled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cases           RecoveryCase[]
  actions         RecoveryAction[]
  auditLogs       AuditLog[]
  sessions        Session[]
  accounts        Account[]
  recoveryTargets RecoveryTarget[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ImportBatch {
  id                   String   @id @default(cuid())
  filename             String
  uploadedAt           DateTime @default(now())
  rowCount             Int
  droppedRowCount      Int      @default(0)
  reconciliationStatus String   @default("Pending") // Pending | Reconciled | Overridden | Failed
  overrideReason       String?
  overriddenById       String?
  notes                String?

  loans                   Loan[]
  financialIntermediaries FinancialIntermediary[]
}

model Loan {
  id                     String    @id @default(cuid())
  importBatchId          String
  loanNo                 String    @unique
  memberNo               String?
  borrowerName           String
  // Agribizz | Asset Finance | Vuka | Go Green | LPO/LSO | Migration | Talanta | VIBE | Group Loan
  product                String
  disbursementDate       DateTime?
  repaymentStartDate     DateTime?
  expectedCompletionDate DateTime?
  lastPayDate            DateTime?
  loanTenor              Int?
  // All monetary values stored as strings to preserve decimal precision — never floats
  approvedAmount         String
  disbursedAmount        String
  totalPaid              String
  outstandingBalance     String
  daysInArrears          Int       @default(0)
  // Normal | Watch | Substandard | Doubtful | Loss
  classification         String
  countyCode             Int?      // 1–47; Group Loan only
  branch                 String?   // Branch / office name, if present in source data

  // Derived / cached fields (computed on import, stored for query performance)
  arrearsBucket     String?  // Current | 1-30 | 31-90 | 91-180 | 181-360 | 360+
  recoveryTier      String?  // Curable | At-risk | Doubtful | Impaired
  dormancyDays      Int?
  isMatured         Boolean  @default(false)
  isCreditBalance   Boolean  @default(false)
  creditBalanceType String?  // True overpayment | Likely misposting

  importBatch  ImportBatch   @relation(fields: [importBatchId], references: [id])
  recoveryCase RecoveryCase?

  @@index([product])
  @@index([classification])
  @@index([recoveryTier])
  @@index([countyCode])
  @@index([branch])
  @@index([arrearsBucket])
  @@index([isMatured])
  @@index([isCreditBalance])
}

// Daily point-in-time rollup of portfolio KPIs, captured by a scheduled job,
// so trend charts have history to plot without re-deriving it from raw loans.
model PortfolioSnapshot {
  id               String   @id @default(cuid())
  capturedAt       DateTime @default(now())
  totalOutstanding String
  totalOverdue     String
  totalAccounts    Int
  recoveryRate     Float?
  nplRatio         Float?
  par30            Float?
  defaultRate      Float?

  @@index([capturedAt])
}

model FinancialIntermediary {
  id                   String  @id @default(cuid())
  importBatchId        String
  name                 String
  county               String?
  disbursed            String
  principalRecovered   String
  interestRecovered    String
  principalOutstanding String
  interestOutstanding  String
  defaultPenalty       String
  totalOutstanding     String

  importBatch ImportBatch @relation(fields: [importBatchId], references: [id])
}

model RecoveryCase {
  id                String    @id @default(cuid())
  loanNo            String    @unique
  assignedOfficerId String?
  // New | In progress | Promised to pay | Restructured | Legal | CRB-listed | Written-off | Recovered | Closed
  status            String    @default("New")
  priorityTier      String?
  nextActionDate    DateTime?
  workflowLevel     Int?      // Last Collection Workflow Automation level applied (1-5)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  loan       Loan             @relation(fields: [loanNo], references: [loanNo])
  officer    User?            @relation(fields: [assignedOfficerId], references: [id])
  actions    RecoveryAction[]
  legalCases LegalCase[]
}

model RecoveryAction {
  id        String   @id @default(cuid())
  caseId    String
  officerId String
  // Call | SMS | Demand letter | Field visit | Restructure offer | Guarantor contact | CRB listing | Legal | Payment received | Note
  type           String
  outcome        String?
  amountPromised String?
  amountReceived String?
  notes          String?
  timestamp      DateTime @default(now())

  case    RecoveryCase @relation(fields: [caseId], references: [id])
  officer User         @relation(fields: [officerId], references: [id])
}

// Admin-configurable Collection Workflow Automation rules (roadmap 1.4/1.13).
// Each level maps a days-in-arrears range to an automatic action; editable
// via Settings without touching code.
model AutomationRule {
  id               String   @id @default(cuid())
  level            Int      @unique // 1-5
  label            String
  minDaysInArrears Int
  maxDaysInArrears Int? // null = no upper bound (open-ended, e.g. Legal)
  // notify | assign_officer | escalate_supervisor | escalate_legal
  action           String
  enabled          Boolean  @default(true)
  updatedAt        DateTime @updatedAt
}

// Per-officer monthly collection targets (roadmap 1.5 "Recovery Targets").
// `periodMonth` is "YYYY-MM"; actual collections for the period are derived
// at read time from RecoveryAction.amountReceived, not stored here.
model RecoveryTarget {
  id           String   @id @default(cuid())
  officerId    String
  periodMonth  String
  targetAmount String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  officer User @relation(fields: [officerId], references: [id])

  @@unique([officerId, periodMonth])
}

// Legal Recovery Management (roadmap 1.10): demand letters, legal notices,
// court cases and asset repossessions tracked against a RecoveryCase, with
// lawyer assignment and status/timeline tracking. `documentRef` is a
// free-text reference (URL or filing number) since there is no file
// storage infra yet — "Document Upload" is scoped to that until one exists.
model LegalCase {
  id             String    @id @default(cuid())
  caseId         String
  // Demand Letter | Legal Notice | Court Case | Asset Repossession
  type           String
  // Draft | Sent | Filed | In court | Resolved | Closed
  status         String    @default("Draft")
  lawyerName     String?
  courtName      String?
  filingDate     DateTime?
  hearingDate    DateTime?
  resolutionDate DateTime?
  notes          String?
  documentRef    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  case RecoveryCase @relation(fields: [caseId], references: [id])

  @@index([caseId])
  @@index([status])
}

// Superadmin-only integration credentials (roadmap "Settings & Credentials").
// `config` is an encrypted (AES-256-GCM) JSON blob of credential fields —
// never stored or logged in plaintext. `lastVerifiedAt` is set by the
// integration's "Test connection" action.
model IntegrationSetting {
  id             String    @id @default(cuid())
  key            String    @unique // e.g. "whatsapp" | "sms" | "smtp" | "mpesa" | ...
  config         String?   // encrypted JSON, null until first saved
  lastVerifiedAt DateTime?
  updatedById    String?
  updatedAt      DateTime  @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String
  entity    String
  entityId  String?
  before    String?  // JSON-serialised snapshot
  after     String?  // JSON-serialised snapshot
  timestamp DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id])
}
